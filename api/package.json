{
  "name": "api-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && next build web",
    "start": "node dist/src/main.js",
    "start:dev": "sh -c 'pids=$(lsof -ti tcp:3004); if [ -n \"$pids\" ]; then kill $pids; fi; exec tsx watch src/main.ts'",
    "start:worker": "WORKER_ENABLED=true tsx src/worker.main.ts",
    "start:worker:dev": "WORKER_ENABLED=true tsx watch src/worker.main.ts",
    "start:debug": "tsx watch --inspect src/main.ts",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.mjs",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --config ./jest.config.mjs",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --config ./jest.config.mjs",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.e2e.config.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:verge": "tsx prisma/seed-verge.ts",
    "articles:reprocess": "tsx prisma/reprocess-articles.ts",
    "web:dev": "next dev web"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/nextjs": "^7.9.17",
    "@extractus/article-extractor": "^8.0.9",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.1.0",
    "nest-winston": "^2.0.0",
    "next": "^16.4.0",
    "openai": "^6.3.0",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
