NODE_ENV=development
PORT=3000
API_PREFIX=api
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>
OPENAI_API_KEY=<optional_for_enrichment>
OPENAI_MODEL=gpt-4o-mini
FEED_SYNC_INTERVAL_MINUTES=30
ARTICLE_EXTRACTION_TIMEOUT_MS=15000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
SWAGGER_ENABLED=true
SENTRY_ENABLED=false
SENTRY_DSN=<optional_sentry_dsn>

AUTH_ENABLED=false
AUTH_JWT_SECRET=<set_a_long_random_secret_when_auth_enabled>
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=7d

MAIL_ENABLED=false
OTP_ENABLED=false
STORAGE_ENABLED=false
WORKER_ENABLED=false
REALTIME_ENABLED=false
API_KEYS_ENABLED=false
PUSH_ENABLED=false
